        </rdfs:subClassOf>
        <terms:creator>http://vocab.getty.edu/page/aat/300125479</terms:creator>
        <terms:description xml:lang="pt-br">A técnica vernacular de construção consiste em preencher os espaços entre as vigas de sustentação com tijolos, taipa ou outros materiais. O termo também é usado para descrever construções com uma estrutura de madeira falsa fixada na parede externa, conferindo a aparência de uma construção em enxaimel.</terms:description>
        <terms:title xml:lang="pt-br">Enxaimel</terms:title>
    </owl:Class>
    


    <!-- http://vocabulario.tradicional.arq.br#300163929 -->

    <owl:Class rdf:about="http://vocabulario.tradicional.arq.br#300163929">
        <rdfs:subClassOf rdf:resource="http://vocab.getty.edu/ontology#Concept"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/iso25964/skos-thes#broaderGeneric"/>
                <owl:someValuesFrom rdf:resource="http://www.co-ode.org/ontologies/ont.owl#OWLClass_0c206ee3_b1a1_4659_be1c_bfc039fb4a6f"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/iso25964/skos-thes#broaderGeneric"/>
                <owl:someValuesFrom rdf:resource="http://www.co-ode.org/ontologies/ont.owl#OWLClass_0e5b01f8_0565_440e_b356_eedf67309147"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:creator>http://vocab.getty.edu/page/aat/300163929</terms:creator>
        <terms:description xml:lang="pt-br">Construção constituída por postes ou estacas verticais entrelaçados com galhos ou ramos de árvores e rebocados com uma mistura de argila e palha.</terms:description>
        <terms:title xml:lang="pt-br">Pau-a-pique (taipa de pilão)</terms:title>
    </owl:Class>
    


    <!-- http://vocabulario.tradicional.arq.br#300198989 -->

    <owl:Class rdf:about="http://vocabulario.tradicional.arq.br#300198989">
        <rdfs:subClassOf rdf:resource="http://vocab.getty.edu/ontology#Concept"/>
        <terms:creator>http://vocab.getty.edu/page/aat/300198989</terms:creator>
        <terms:description xml:lang="pt-br">Instrumentos que medem e indicam o valor de uma quantidade de algo, como gás, líquido, milhas ou tempo.</terms:description>
        <terms:title xml:lang="pt-br">metro (instrumento de medição)</terms:title>
    </owl:Class>
    


    <!-- http://vocabulario.tradicional.arq.br#300266766 -->

    <owl:Class rdf:about="http://vocabulario.tradicional.arq.br#300266766">
        <rdfs:subClassOf rdf:resource="http://vocab.getty.edu/ontology#Concept"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/iso25964/skos-thes#broaderGeneric"/>
                <owl:someValuesFrom rdf:resource="http://www.co-ode.org/ontologies/ont.owl#OWLClass_227c7e8e_84b3_435d_b1ef_92e7f65b9a3d"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://vocab.getty.edu/ontology#broaderPreferred"/>
                <owl:someValuesFrom rdf:resource="http://www.co-ode.org/ontologies/ont.owl#OWLClass_227c7e8e_84b3_435d_b1ef_92e7f65b9a3d"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:creator>http://vocab.getty.edu/page/aat/300266766</terms:creator>
        <terms:description xml:lang="pt-br">Janelas em caixilho deslizante, com folha de abertura vertical ou horizontal, mas geralmente não janelas de guilhotina dupla.</terms:description>
        <terms:title xml:lang="pt-br">Caixilho (janelas de guilhotina)</terms:title>
    </owl:Class>
    


    <!-- http://vocabulario.tradicional.arq.br#300379097 -->

    <owl:Class rdf:about="http://vocabulario.tradicional.arq.br#300379097">
        <rdfs:subClassOf rdf:resource="http://vocab.getty.edu/ontology#Concept"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/iso25964/skos-thes#broaderGeneric"/>
                <owl:someValuesFrom rdf:resource="http://vocabulario.tradicional.arq.br#300198989"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:creator>http://vocab.getty.edu/page/aat/300379097</terms:creator>
        <terms:description xml:lang="pt-br">Unidades de comprimento iguais a 0,001 metro, 0,3937 polegadas.</terms:description>
        <terms:title xml:lang="pt-br">milímetro</terms:title>
    </owl:Class>
    


    <!-- http://vocabulario.tradicional.arq.br#300379098 -->

    <owl:Class rdf:about="http://vocabulario.tradicional.arq.br#300379098">
        <rdfs:subClassOf rdf:resource="http://vocab.getty.edu/ontology#Concept"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/iso25964/skos-thes#broaderGeneric"/>
                <owl:someValuesFrom rdf:resource="http://vocabulario.tradicional.arq.br#300198989"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:creator>http://vocab.getty.edu/page/aat/300379098</terms:creator>
        <terms:description xml:lang="pt-br">No sistema métrico, as unidades de comprimento equivalem a 1/100 de um metro, ou 0,3937 polegadas (quase 2/5).</terms:description>
        <terms:title xml:lang="pt-br">centímetro</terms:title>
    </owl:Class>
    


    <!-- http://vocabulario.tradicional.arq.br#300386877 -->

    <owl:Class rdf:about="http://vocabulario.tradicional.arq.br#300386877">
        <rdfs:subClassOf rdf:resource="http://vocab.getty.edu/ontology#Concept"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/iso25964/skos-thes#broaderGeneric"/>
                <owl:someValuesFrom rdf:resource="http://www.co-ode.org/ontologies/ont.owl#OWLClass_0c206ee3_b1a1_4659_be1c_bfc039fb4a6f"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://vocab.getty.edu/ontology#broaderPreferred"/>
                <owl:someValuesFrom rdf:resource="http://www.co-ode.org/ontologies/ont.owl#OWLClass_0c206ee3_b1a1_4659_be1c_bfc039fb4a6f"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:creator>http://vocab.getty.edu/page/aat/300386877</terms:creator>
        <terms:description xml:lang="pt-br">Um tipo de gesso composto de óxido de cálcio (cal). O gesso de cal é usado desde a antiguidade, sendo preparado pelo aquecimento do calcário para remover o dióxido de carbono e convertê-lo em óxido de cálcio anidro (cal viva). Quando a cal viva é misturada com água, ela se transforma em hidróxido de cálcio (cal hidratada).</terms:description>
        <terms:title xml:lang="pt-br">Estuque</terms:title>
    </owl:Class>
    


    <!-- http://vocabulario.tradicional.arq.br#300404401 -->

    <owl:Class rdf:about="http://vocabulario.tradicional.arq.br#300404401">
        <rdfs:subClassOf rdf:resource="http://vocab.getty.edu/ontology#Concept"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/iso25964/skos-thes#broaderGeneric"/>
                <owl:someValuesFrom rdf:resource="http://vocabulario.tradicional.arq.br#300198989"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:creator>http://vocab.getty.edu/page/aat/300404401</terms:creator>
        <terms:description xml:lang="pt-br">Unidades métricas de área; área de um quadrado com lados que medem um metro.</terms:description>
        <terms:title xml:lang="pt-br">metro quadrado</terms:title>
    </owl:Class>
    


    <!-- http://vocabulario.tradicional.arq.br#300410343 -->

    <owl:Class rdf:about="http://vocabulario.tradicional.arq.br#300410343">
        <rdfs:subClassOf rdf:resource="http://vocab.getty.edu/ontology#Concept"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/iso25964/skos-thes#broaderGeneric"/>
                <owl:someValuesFrom rdf:resource="http://www.co-ode.org/ontologies/ont.owl#OWLClass_0c206ee3_b1a1_4659_be1c_bfc039fb4a6f"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://vocab.getty.edu/ontology#broaderPreferred"/>
                <owl:someValuesFrom rdf:resource="http://www.co-ode.org/ontologies/ont.owl#OWLClass_0c206ee3_b1a1_4659_be1c_bfc039fb4a6f"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:creator>http://vocab.getty.edu/page/aat/300410343</terms:creator>
        <terms:description xml:lang="pt-br">Obras visuais compostas por azulejos ou que utilizam azulejos como meio principal. Para obras em que um azulejo individual serve de suporte para um desenho ou imagem, utilize &quot;azulejos artísticos (obras visuais)&quot;. As obras com azulejos podem incorporar azulejos decorados ou podem ser compostas por azulejos sem decoração.</terms:description>
        <terms:title xml:lang="pt-br">Azulejaria Trabalho com azulejos (obras visuais)</terms:title>
    </owl:Class>
    


    <!-- http://vocabulario.tradicional.arq.br#300440767 -->

    <owl:Class rdf:about="http://vocabulario.tradicional.arq.br#300440767">
        <rdfs:subClassOf rdf:resource="http://vocab.getty.edu/ontology#Concept"/>
