        <terms:description xml:lang="pt-br">Refere-se às residências principais, e geralmente maiores, nas plantações.</terms:description>
        <terms:title xml:lang="pt-br">Casa-grande (casas de plantação)</terms:title>
    </owl:Class>
    


    <!-- http://vocabulario.tradicional.arq.br#300007495 -->

    <owl:Class rdf:about="http://vocabulario.tradicional.arq.br#300007495">
