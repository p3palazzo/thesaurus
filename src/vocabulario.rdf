        <terms:description xml:lang="pt-br">Igrejas que formam o centro de uma abadia.</terms:description>
        <terms:title xml:lang="pt">Abadia</terms:title>
    </owl:Class>
    


    <!-- http://vocabulario.tradicional.arq.br#300007872 -->

    <owl:Class rdf:about="http://vocabulario.tradicional.arq.br#300007872">
        <rdfs:subClassOf rdf:resource="http://vocab.getty.edu/ontology#Concept"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/iso25964/skos-thes#broaderGeneric"/>
                <owl:someValuesFrom rdf:resource="http://www.co-ode.org/ontologies/ont.owl#OWLClass_227c7e8e_84b3_435d_b1ef_92e7f65b9a3d"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://vocab.getty.edu/ontology#broaderPreferred"/>
                <owl:someValuesFrom rdf:resource="http://www.co-ode.org/ontologies/ont.owl#OWLClass_227c7e8e_84b3_435d_b1ef_92e7f65b9a3d"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:creator>http://vocab.getty.edu/page/aat/300007872</terms:creator>
        <terms:description xml:lang="pt-br">Estruturas de treliça de madeira que transportam uma estrada ou linha férrea sobre um rio ou outro obstáculo, caracterizadas pelo telhado e laterais que formam um fechamento quase completo para proteger os elementos estruturais de madeira das intempéries. Não há evidências de pontes de treliça de madeira, com ou sem cobertura, no mundo antigo; no entanto, existem desenhos de pontes cobertas que datam do século XIV e posteriores na Europa. Na América do Norte, as pontes de madeira cobertas eram comuns do século XVIII até o início do século XX, embora estivessem sendo gradualmente substituídas por pontes de treliça metálica, que não necessitavam de cobertura.</terms:description>
        <terms:title xml:lang="pt-br">Passadiço (pontes cobertas)</terms:title>
    </owl:Class>
    


    <!-- http://vocabulario.tradicional.arq.br#300010525 -->

    <owl:Class rdf:about="http://vocabulario.tradicional.arq.br#300010525">
        <rdfs:subClassOf rdf:resource="http://vocab.getty.edu/ontology#Concept"/>
        <rdfs:subClassOf>
