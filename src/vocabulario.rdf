        <terms:created>2026-08-15D00:00:00Z</terms:created>
        <terms:description xml:lang="pt-br">Nos telhados que vencem vãos grandes, sem o auxílio de paredes internas, nome do sistema estrutural triangular indeformável que sustenta a cobertura propriamente dita.</terms:description>
        <terms:title xml:lang="pt-br">Tesoura</terms:title>
    </owl:Class>
    


