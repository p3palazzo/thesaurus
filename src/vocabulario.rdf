                <owl:someValuesFrom rdf:resource="https://vocab.getty.edu/aat/300004790"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:creator>http://vocab.getty.edu/page/aat/300457778</terms:creator>
        <terms:description xml:lang="pt-br">Grandes casas ou propriedades rurais na Espanha, Portugal e América Latina, localizadas no campo ou nos arredores de uma cidade; podem estar associadas a vinhedos ou fazendas de gado.</terms:description>
        <terms:title xml:lang="pt-br">Quinta</terms:title>
    </owl:Class>
    


