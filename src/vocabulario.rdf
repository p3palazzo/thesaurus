        <terms:creator>http://vocab.getty.edu/page/aat/300001699</terms:creator>
        <terms:description xml:lang="pt-br">Elementos superiores dos capitéis de colunas; frequentemente lajes quadradas lisas, mas por vezes molduradas ou de outra forma ornamentadas.</terms:description>
        <terms:title xml:lang="pt">abaco</terms:title>
    </owl:Class>
    


    <!-- http://vocabulario.tradicional.arq.br#300001749 -->

    <owl:Class rdf:about="http://vocabulario.tradicional.arq.br#300001749">
        <rdfs:subClassOf rdf:resource="http://vocab.getty.edu/ontology#Concept"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/iso25964/skos-thes#broaderGeneric"/>
                <owl:someValuesFrom rdf:resource="http://www.co-ode.org/ontologies/ont.owl#OWLClass_227c7e8e_84b3_435d_b1ef_92e7f65b9a3d"/>
            </owl:Restriction>
