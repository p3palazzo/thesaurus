            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/iso25964/skos-thes#broaderGeneric"/>
                <owl:someValuesFrom rdf:resource="http://www.co-ode.org/ontologies/ont.owl#OWLClass_b9729b20_de09_4e92_a802_f7a213e5fe4f"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/iso25964/skos-thes#broaderGeneric"/>
                <owl:someValuesFrom rdf:resource="https://vocab.getty.edu/aat/300004790"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://vocab.getty.edu/ontology#broaderPreferred"/>
                <owl:someValuesFrom rdf:resource="https://vocab.getty.edu/aat/300004790"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:creator>http://vocab.getty.edu/page/aat/300440767</terms:creator>
        <terms:description xml:lang="pt-br">Anexos utilizados para cozinhar, especialmente durante os meses quentes de verão, quando era desejável manter o calor do fogão e do forno fisicamente separado do resto da casa e dos aposentos.</terms:description>
        <terms:title xml:lang="pt-br">Cozinha de fumaça</terms:title>
    </owl:Class>
    


    <!-- http://vocabulario.tradicional.arq.br#300445666 -->

    <owl:Class rdf:about="http://vocabulario.tradicional.arq.br#300445666">
        <rdfs:subClassOf rdf:resource="http://vocab.getty.edu/ontology#Concept"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/iso25964/skos-thes#broaderGeneric"/>
                <owl:someValuesFrom rdf:resource="http://www.co-ode.org/ontologies/ont.owl#OWLClass_227c7e8e_84b3_435d_b1ef_92e7f65b9a3d"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/iso25964/skos-thes#broaderGeneric"/>
                <owl:someValuesFrom rdf:resource="http://www.co-ode.org/ontologies/ont.owl#OWLClass_8c3396da_f987_4888_9b74_83df96908386"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
