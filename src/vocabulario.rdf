        <terms:title xml:lang="pt-br">Bandeira</terms:title>
    </owl:Class>
    


    <!-- http://vocabulario.tradicional.arq.br#000000018 -->

    <owl:Class rdf:about="http://vocabulario.tradicional.arq.br#000000018">
        <rdfs:subClassOf rdf:resource="http://vocab.getty.edu/ontology#Concept"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/iso25964/skos-thes#broaderGeneric"/>
                <owl:someValuesFrom rdf:resource="http://vocabulario.tradicional.arq.br#300198989"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:creator>https://orcid.org/0009-0002-8934-6608</terms:creator>
        <terms:description xml:lang="pt-br">Antiga medida de extensãoequivalente a 8 polegadas ou 0,225m. Medida tomada com a mão aberta, e que vai de estremidade do dedo polegar à ponta do dedo mínimo. &quot;Palmo craveiro&quot;, segundo o padrão da câmara de Lisboa. O côvado tinha três palmos craveiros.</terms:description>
        <terms:title xml:lang="pt-br">palmo</terms:title>
    </owl:Class>
    


    <!-- http://vocabulario.tradicional.arq.br#000000019 -->

    <owl:Class rdf:about="http://vocabulario.tradicional.arq.br#000000019">
        <rdfs:subClassOf rdf:resource="http://vocab.getty.edu/ontology#Concept"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/iso25964/skos-thes#broaderGeneric"/>
                <owl:someValuesFrom rdf:resource="http://vocabulario.tradicional.arq.br#300125479"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/iso25964/skos-thes#broaderGeneric"/>
                <owl:someValuesFrom rdf:resource="http://www.co-ode.org/ontologies/ont.owl#OWLClass_0c206ee3_b1a1_4659_be1c_bfc039fb4a6f"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://vocab.getty.edu/ontology#broaderPreferred"/>
                <owl:someValuesFrom rdf:resource="http://vocabulario.tradicional.arq.br#300125479"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:creator>https://orcid.org/0009-0002-8934-6608</terms:creator>
        <terms:description xml:lang="pt-br">Nome do esqueleto de mandeira das paredes externas de uma construção, com posto de peças verticais, horizontais e inclinadas convenientemente ligadas entre si, constituindo sistema estável. Posteriormente os vãos existentes são preechidos com alvenaria ordinária ou com miúda, constituída de cacis de telha ou tijolos argamassados. Parede FRONTAL. Omesmo que cárcere ou prisão. Janela gradeada. Nome de edifício construído às pressas e com materiais inferiores, sujeito a desabamento, casa pequena, casinholaa.</terms:description>
        <terms:title xml:lang="pt-br">gaiola</terms:title>
    </owl:Class>
    


    <!-- http://vocabulario.tradicional.arq.br#000000020 -->

    <owl:Class rdf:about="http://vocabulario.tradicional.arq.br#000000020">
        <rdfs:subClassOf rdf:resource="http://vocab.getty.edu/ontology#Concept"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/iso25964/skos-thes#broaderGeneric"/>
                <owl:someValuesFrom rdf:resource="http://vocabulario.tradicional.arq.br#300002425"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/iso25964/skos-thes#broaderGeneric"/>
                <owl:someValuesFrom rdf:resource="http://www.co-ode.org/ontologies/ont.owl#OWLClass_227c7e8e_84b3_435d_b1ef_92e7f65b9a3d"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:contributor>https://orcid.org/0009-0002-8934-6608</terms:contributor>
        <terms:created>2026-08-15D00:00:00Z</terms:created>
        <terms:description xml:lang="pt-br">Designação genérica aplicada aos alicerces de alvenaria em geral ou às vigas de concreto armado que correm as fundações de qualquer tipo. Também chama-se de baldrame a peça de madeira deitada ao longo dos alicerces de alvenaria que recebe o vigamento dos assoalhos. É a viga de madeira ensamblada nos esteios sobre a qual se apoia numa parede de vedação, desde a de taipa de mão até a de alvenaria.</terms:description>
        <terms:title xml:lang="pt-br">Baldrame</terms:title>
    </owl:Class>
    


    <!-- http://vocabulario.tradicional.arq.br#000000021 -->

    <owl:Class rdf:about="http://vocabulario.tradicional.arq.br#000000021">
        <rdfs:subClassOf rdf:resource="http://vocab.getty.edu/ontology#Concept"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/iso25964/skos-thes#broaderGeneric"/>
                <owl:someValuesFrom rdf:resource="http://www.co-ode.org/ontologies/ont.owl#OWLClass_227c7e8e_84b3_435d_b1ef_92e7f65b9a3d"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://vocab.getty.edu/ontology#broaderPreferred"/>
                <owl:someValuesFrom rdf:resource="http://www.co-ode.org/ontologies/ont.owl#OWLClass_227c7e8e_84b3_435d_b1ef_92e7f65b9a3d"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:contributor>https://orcid.org/0009-0002-8934-6608</terms:contributor>
        <terms:created>2026-08-15D00:00:00Z</terms:created>
        <terms:description xml:lang="pt-br">Peça de madeira, ferro, pedra, etc. usada para segurar ou amparar alguma coisa. Em geral o termo é mais empregado para designar estaca com que se sustenta ou escora o teto ou uma parede. Diz-se &quot;os esteios dos cunhais&quot;, isto é, as estacas situadas nos cantos externos das construções, sobre as quais cruzam-se os frechais.</terms:description>
        <terms:title xml:lang="pt-br">Esteio</terms:title>
    </owl:Class>
    


    <!-- http://vocabulario.tradicional.arq.br#000000022 -->

    <owl:Class rdf:about="http://vocabulario.tradicional.arq.br#000000022">
        <rdfs:subClassOf rdf:resource="http://vocab.getty.edu/ontology#Concept"/>
