            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:creator>http://vocab.getty.edu/page/aat/300070138</terms:creator>
        <terms:description xml:lang="pt-br">Pavilhões em coberturas projetados como mirantes ou para apreciar a vista. Para plataformas sem cobertura, use &quot;mirantes&quot;; para estruturas em coberturas que sejam principalmente ornamentais, use &quot;cúpulas&quot;; para pequenos pavilhões, em um jardim, projetados para apreciar a vista, use &quot;gazebos&quot;.</terms:description>
        <terms:title xml:lang="pt-br">Camarinha (mirantes)</terms:title>
    </owl:Class>
    


    <!-- http://vocabulario.tradicional.arq.br#300080798 -->

