            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:creator>http://vocab.getty.edu/page/aat/300053060</terms:creator>
        <terms:description xml:lang="pt-br">A ação ou processo de revestir uma superfície, como uma parede, com cal: uma substância mineral em pó, como hidróxido de cálcio ou giz, suspensa em água, frequentemente com cola ou outros ingredientes.</terms:description>
        <terms:title xml:lang="pt-br">Caiadura</terms:title>
    </owl:Class>
    


    <!-- http://vocabulario.tradicional.arq.br#300070138 -->

