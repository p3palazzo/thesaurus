                <owl:onProperty rdf:resource="http://vocab.getty.edu/ontology#broaderPreferred"/>
                <owl:someValuesFrom rdf:resource="http://www.co-ode.org/ontologies/ont.owl#OWLClass_227c7e8e_84b3_435d_b1ef_92e7f65b9a3d"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:creator>http://vocab.getty.edu/page/aat/300001749</terms:creator>
        <terms:description xml:lang="pt-br">Elementos de suporte retangulares ou quadrados, ou blocos inferiores, como colunas, pilastras ou caixilhos de portas; também bases monumentais maciças, frequentemente ornamentadas, usadas para suportar estátuas ou memoriais. Para as bases de paredes externas ou as fiadas de base em forma de plataforma de edifícios, use &quot;fiadas de plinto&quot;.</terms:description>
        <terms:title xml:lang="pt-br">Embasamento (plintos)</terms:title>
    </owl:Class>
    


    <!-- http://vocabulario.tradicional.arq.br#300001783 -->

    <owl:Class rdf:about="http://vocabulario.tradicional.arq.br#300001783">
        <rdfs:subClassOf rdf:resource="http://vocab.getty.edu/ontology#Concept"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/iso25964/skos-thes#broaderGeneric"/>
                <owl:someValuesFrom rdf:resource="http://www.co-ode.org/ontologies/ont.owl#OWLClass_227c7e8e_84b3_435d_b1ef_92e7f65b9a3d"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://vocab.getty.edu/ontology#broaderPreferred"/>
                <owl:someValuesFrom rdf:resource="http://www.co-ode.org/ontologies/ont.owl#OWLClass_227c7e8e_84b3_435d_b1ef_92e7f65b9a3d"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:creator>http://vocab.getty.edu/page/aat/300001783</terms:creator>
        <terms:description xml:lang="pt-br">Tiras planas em arquitraves jônicas e coríntias. Para tábuas pregadas nas extremidades das vigas em construções de madeira, use &quot;tábuas de beiral&quot;.</terms:description>
        <terms:title xml:lang="pt-br">Cimalha (fáscias (componentes de arquitrave))</terms:title>
    </owl:Class>
    


    <!-- http://vocabulario.tradicional.arq.br#300001838 -->

    <owl:Class rdf:about="http://vocabulario.tradicional.arq.br#300001838">
        <rdfs:subClassOf rdf:resource="http://vocab.getty.edu/ontology#Concept"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/iso25964/skos-thes#broaderGeneric"/>
                <owl:someValuesFrom rdf:resource="http://vocabulario.tradicional.arq.br#000000022"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/iso25964/skos-thes#broaderGeneric"/>
                <owl:someValuesFrom rdf:resource="http://www.co-ode.org/ontologies/ont.owl#OWLClass_227c7e8e_84b3_435d_b1ef_92e7f65b9a3d"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:creator>http://vocab.getty.edu/page/aat/300001838</terms:creator>
        <terms:description xml:lang="pt-br">Elementos colocados transversalmente na parte interna de um ângulo em uma estrutura para adicionar rigidez à mesma, como entre elementos de telhado e elementos de parede.</terms:description>
        <terms:title xml:lang="pt-br">Mão-francesa</terms:title>
    </owl:Class>
    


    <!-- http://vocabulario.tradicional.arq.br#300002214 -->

    <owl:Class rdf:about="http://vocabulario.tradicional.arq.br#300002214">
        <rdfs:subClassOf rdf:resource="http://vocab.getty.edu/ontology#Concept"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/iso25964/skos-thes#broaderGeneric"/>
                <owl:someValuesFrom rdf:resource="http://vocabulario.tradicional.arq.br#300002726"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/iso25964/skos-thes#broaderGeneric"/>
                <owl:someValuesFrom rdf:resource="http://www.co-ode.org/ontologies/ont.owl#OWLClass_227c7e8e_84b3_435d_b1ef_92e7f65b9a3d"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://vocab.getty.edu/ontology#broaderPreferred"/>
                <owl:someValuesFrom rdf:resource="http://vocabulario.tradicional.arq.br#300002726"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:creator>http://vocab.getty.edu/page/aat/300002214</terms:creator>
        <terms:description xml:lang="pt-br">As figuras ou ornamentos nos ângulos inferiores ou no ápice de um frontão, geralmente apoiados em plintos.</terms:description>
        <terms:title xml:lang="pt-br">Acrotério</terms:title>
    </owl:Class>
    


    <!-- http://vocabulario.tradicional.arq.br#300002232 -->

    <owl:Class rdf:about="http://vocabulario.tradicional.arq.br#300002232">
        <rdfs:subClassOf rdf:resource="http://vocab.getty.edu/ontology#Concept"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/iso25964/skos-thes#broaderGeneric"/>
                <owl:someValuesFrom rdf:resource="http://www.co-ode.org/ontologies/ont.owl#OWLClass_227c7e8e_84b3_435d_b1ef_92e7f65b9a3d"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://vocab.getty.edu/ontology#broaderPreferred"/>
                <owl:someValuesFrom rdf:resource="http://www.co-ode.org/ontologies/ont.owl#OWLClass_227c7e8e_84b3_435d_b1ef_92e7f65b9a3d"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:creator>http://vocab.getty.edu/page/aat/300002232</terms:creator>
        <terms:description xml:lang="pt-br">Estruturas que se projetam de um telhado inclinado geralmente abrigam uma janela ou veneziana de ventilação.</terms:description>
        <terms:title xml:lang="pt-br">Água-furtada</terms:title>
    </owl:Class>
    


    <!-- http://vocabulario.tradicional.arq.br#300002268 -->

    <owl:Class rdf:about="http://vocabulario.tradicional.arq.br#300002268">
        <rdfs:subClassOf rdf:resource="http://vocab.getty.edu/ontology#Concept"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/iso25964/skos-thes#broaderGeneric"/>
                <owl:someValuesFrom rdf:resource="http://www.co-ode.org/ontologies/ont.owl#OWLClass_227c7e8e_84b3_435d_b1ef_92e7f65b9a3d"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://vocab.getty.edu/ontology#broaderPreferred"/>
                <owl:someValuesFrom rdf:resource="http://www.co-ode.org/ontologies/ont.owl#OWLClass_227c7e8e_84b3_435d_b1ef_92e7f65b9a3d"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:creator>http://vocab.getty.edu/page/aat/300002268</terms:creator>
        <terms:description xml:lang="pt-br">Refere-se às porções horizontais de um telhado inclinado que se projetam além das paredes. Para as porções do telhado que se projetam além do frontão, use &quot;beiral&quot;.</terms:description>
        <terms:title xml:lang="pt">Beiral</terms:title>
    </owl:Class>
    


    <!-- http://vocabulario.tradicional.arq.br#300002370 -->

    <owl:Class rdf:about="http://vocabulario.tradicional.arq.br#300002370">
        <rdfs:subClassOf rdf:resource="http://vocab.getty.edu/ontology#Concept"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/iso25964/skos-thes#broaderGeneric"/>
                <owl:someValuesFrom rdf:resource="http://vocabulario.tradicional.arq.br#300002425"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/iso25964/skos-thes#broaderGeneric"/>
                <owl:someValuesFrom rdf:resource="http://www.co-ode.org/ontologies/ont.owl#OWLClass_227c7e8e_84b3_435d_b1ef_92e7f65b9a3d"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:creator>http://vocab.getty.edu/page/aat/300002370</terms:creator>
        <terms:description xml:lang="pt-br">Ângulos internos em um telhado formados pelo encontro de duas águas.</terms:description>
        <terms:title xml:lang="pt-br">Rincão</terms:title>
    </owl:Class>
    


    <!-- http://vocabulario.tradicional.arq.br#300002403 -->

    <owl:Class rdf:about="http://vocabulario.tradicional.arq.br#300002403">
        <rdfs:subClassOf rdf:resource="http://vocab.getty.edu/ontology#Concept"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/iso25964/skos-thes#broaderGeneric"/>
                <owl:someValuesFrom rdf:resource="http://vocabulario.tradicional.arq.br#300002425"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/iso25964/skos-thes#broaderGeneric"/>
                <owl:someValuesFrom rdf:resource="http://www.co-ode.org/ontologies/ont.owl#OWLClass_227c7e8e_84b3_435d_b1ef_92e7f65b9a3d"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:creator>http://vocab.getty.edu/page/aat/300002403</terms:creator>
        <terms:description xml:lang="pt-br">Elementos longitudinais nos vértices dos telhados que suportam as extremidades superiores das vigas.</terms:description>
        <terms:title xml:lang="pt-br">Cumeeira</terms:title>
    </owl:Class>
    


    <!-- http://vocabulario.tradicional.arq.br#300002425 -->

    <owl:Class rdf:about="http://vocabulario.tradicional.arq.br#300002425">
        <rdfs:subClassOf rdf:resource="http://vocab.getty.edu/ontology#Concept"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/iso25964/skos-thes#broaderGeneric"/>
                <owl:someValuesFrom rdf:resource="http://www.co-ode.org/ontologies/ont.owl#OWLClass_227c7e8e_84b3_435d_b1ef_92e7f65b9a3d"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://vocab.getty.edu/ontology#broaderPreferred"/>
                <owl:someValuesFrom rdf:resource="http://www.co-ode.org/ontologies/ont.owl#OWLClass_227c7e8e_84b3_435d_b1ef_92e7f65b9a3d"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:creator>http://vocab.getty.edu/page/aat/300002425</terms:creator>
        <terms:description xml:lang="pt-br">Vigas que formam um ângulo reto com a beira do telhado e se estendem da placa até a cumeeira.</terms:description>
        <terms:title xml:lang="pt-br">vigas comuns</terms:title>
    </owl:Class>
    


    <!-- http://vocabulario.tradicional.arq.br#300002431 -->

    <owl:Class rdf:about="http://vocabulario.tradicional.arq.br#300002431">
        <rdfs:subClassOf rdf:resource="http://vocab.getty.edu/ontology#Concept"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/iso25964/skos-thes#broaderGeneric"/>
                <owl:someValuesFrom rdf:resource="http://www.co-ode.org/ontologies/ont.owl#OWLClass_227c7e8e_84b3_435d_b1ef_92e7f65b9a3d"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://vocab.getty.edu/ontology#broaderPreferred"/>
                <owl:someValuesFrom rdf:resource="http://www.co-ode.org/ontologies/ont.owl#OWLClass_227c7e8e_84b3_435d_b1ef_92e7f65b9a3d"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:creator>http://vocab.getty.edu/page/aat/300002431</terms:creator>
        <terms:description xml:lang="pt-br">Vigas colocadas na junção dos planos inclinados que formam os telhados de quatro águas.</terms:description>
        <terms:title xml:lang="pt-br">Espigão (caibros)</terms:title>
    </owl:Class>
    


    <!-- http://vocabulario.tradicional.arq.br#300002538 -->

    <owl:Class rdf:about="http://vocabulario.tradicional.arq.br#300002538">
        <rdfs:subClassOf rdf:resource="http://vocab.getty.edu/ontology#Concept"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/iso25964/skos-thes#broaderGeneric"/>
                <owl:someValuesFrom rdf:resource="http://www.co-ode.org/ontologies/ont.owl#OWLClass_227c7e8e_84b3_435d_b1ef_92e7f65b9a3d"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://vocab.getty.edu/ontology#broaderPreferred"/>
                <owl:someValuesFrom rdf:resource="http://www.co-ode.org/ontologies/ont.owl#OWLClass_227c7e8e_84b3_435d_b1ef_92e7f65b9a3d"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:creator>http://vocab.getty.edu/page/aat/300002538</terms:creator>
        <terms:description xml:lang="pt-br">Paredes internas que separam uma parte de um espaço de outra; às vezes paredes internas permanentes que dividem edifícios em vários cômodos, outras vezes projetadas para se moverem e abrirem um espaço. Para elementos que não sejam paredes e que dividam espaços internos, frequentemente incorporando estantes, armários ou gavetas, use &quot;divisórias de ambiente&quot;.</terms:description>
        <terms:title xml:lang="pt-br">Oitão (partições (paredes internas))</terms:title>
    </owl:Class>
    


    <!-- http://vocabulario.tradicional.arq.br#300002588 -->

    <owl:Class rdf:about="http://vocabulario.tradicional.arq.br#300002588">
        <rdfs:subClassOf rdf:resource="http://vocab.getty.edu/ontology#Concept"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/iso25964/skos-thes#broaderGeneric"/>
                <owl:someValuesFrom rdf:resource="http://www.co-ode.org/ontologies/ont.owl#OWLClass_227c7e8e_84b3_435d_b1ef_92e7f65b9a3d"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://vocab.getty.edu/ontology#broaderPreferred"/>
                <owl:someValuesFrom rdf:resource="http://www.co-ode.org/ontologies/ont.owl#OWLClass_227c7e8e_84b3_435d_b1ef_92e7f65b9a3d"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:creator>http://vocab.getty.edu/page/aat/300002588</terms:creator>
        <terms:description xml:lang="pt-br">Plataformas com corrimão que se projetam das paredes externas dos edifícios. Use também para elementos internos semelhantes, quando pequenos. Para plataformas maiores que se estendem por toda a lateral de uma sala ou que ficam recuadas atrás de uma arcada, use &quot;galerias (espaços do nível superior)&quot;.</terms:description>
        <terms:title xml:lang="pt-br">varandas</terms:title>
    </owl:Class>
    


    <!-- http://vocabulario.tradicional.arq.br#300002696 -->

    <owl:Class rdf:about="http://vocabulario.tradicional.arq.br#300002696">
        <rdfs:subClassOf rdf:resource="http://vocab.getty.edu/ontology#Concept"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/iso25964/skos-thes#broaderGeneric"/>
                <owl:someValuesFrom rdf:resource="http://vocabulario.tradicional.arq.br#300266766"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/iso25964/skos-thes#broaderGeneric"/>
                <owl:someValuesFrom rdf:resource="http://www.co-ode.org/ontologies/ont.owl#OWLClass_227c7e8e_84b3_435d_b1ef_92e7f65b9a3d"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://vocab.getty.edu/ontology#broaderPreferred"/>
                <owl:someValuesFrom rdf:resource="http://vocabulario.tradicional.arq.br#300266766"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:creator>http://vocab.getty.edu/page/aat/300002696</terms:creator>
        <terms:description xml:lang="pt-br">Na arquitetura islâmica, as janelas eram preenchidas com grades ou telas de madeira torneada. Para treliças ou telas de pedra perfurada, na arquitetura islâmica, especialmente na Índia Mughal, usa-se &quot;jali&quot;.</terms:description>
        <terms:title xml:lang="pt-br">muxarabi</terms:title>
    </owl:Class>
    


    <!-- http://vocabulario.tradicional.arq.br#300002726 -->

    <owl:Class rdf:about="http://vocabulario.tradicional.arq.br#300002726">
        <rdfs:subClassOf rdf:resource="http://vocab.getty.edu/ontology#Concept"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/iso25964/skos-thes#broaderGeneric"/>
                <owl:someValuesFrom rdf:resource="http://www.co-ode.org/ontologies/ont.owl#OWLClass_227c7e8e_84b3_435d_b1ef_92e7f65b9a3d"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://vocab.getty.edu/ontology#broaderPreferred"/>
                <owl:someValuesFrom rdf:resource="http://www.co-ode.org/ontologies/ont.owl#OWLClass_227c7e8e_84b3_435d_b1ef_92e7f65b9a3d"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:creator>http://vocab.getty.edu/page/aat/300002726</terms:creator>
        <terms:description xml:lang="pt-br">Paredes triangulares com empena acima da cornija horizontal de um edifício de estilo clássico; também, elementos triangulares ou aproximadamente triangulares, por vezes curvos ou interrompidos no centro, que coroam pórticos ou aberturas. Comuns também em mobiliário, incluindo como tampos de capota.</terms:description>
        <terms:title xml:lang="pt-br">frontões</terms:title>
    </owl:Class>
    


    <!-- http://vocabulario.tradicional.arq.br#300002737 -->

    <owl:Class rdf:about="http://vocabulario.tradicional.arq.br#300002737">
        <rdfs:subClassOf rdf:resource="http://vocab.getty.edu/ontology#Concept"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/iso25964/skos-thes#broaderGeneric"/>
                <owl:someValuesFrom rdf:resource="http://www.co-ode.org/ontologies/ont.owl#OWLClass_227c7e8e_84b3_435d_b1ef_92e7f65b9a3d"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://vocab.getty.edu/ontology#broaderPreferred"/>
                <owl:someValuesFrom rdf:resource="http://www.co-ode.org/ontologies/ont.owl#OWLClass_227c7e8e_84b3_435d_b1ef_92e7f65b9a3d"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:creator>http://vocab.getty.edu/page/aat/300002737</terms:creator>
        <terms:description xml:lang="pt-br">Pilares rasos ou colunas retangulares que se projetam ligeiramente da parede e, na arquitetura clássica, seguem uma das ordens arquitetônicas. Comuns também em móveis.</terms:description>
        <terms:title xml:lang="pt-br">Pilastra</terms:title>
    </owl:Class>
    


    <!-- http://vocabulario.tradicional.arq.br#300002800 -->

    <owl:Class rdf:about="http://vocabulario.tradicional.arq.br#300002800">
        <rdfs:subClassOf rdf:resource="http://vocab.getty.edu/ontology#Concept"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/iso25964/skos-thes#broaderGeneric"/>
                <owl:someValuesFrom rdf:resource="http://vocabulario.tradicional.arq.br#300003146"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/iso25964/skos-thes#broaderGeneric"/>
                <owl:someValuesFrom rdf:resource="http://www.co-ode.org/ontologies/ont.owl#OWLClass_227c7e8e_84b3_435d_b1ef_92e7f65b9a3d"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://vocab.getty.edu/ontology#broaderPreferred"/>
                <owl:someValuesFrom rdf:resource="http://vocabulario.tradicional.arq.br#300003146"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:creator>http://vocab.getty.edu/page/aat/300002800</terms:creator>
        <terms:description xml:lang="pt-br">Tiras fixadas ao chão sob uma porta, geralmente necessárias para cobrir a junção entre dois tipos de piso; podem fornecer proteção contra intempéries em portas externas; para as laterais inferiores e a parte inferior das portas, use &quot;soleiras&quot;.</terms:description>
        <terms:title xml:lang="pt-br">Soleira (limiares)</terms:title>
    </owl:Class>
    


    <!-- http://vocabulario.tradicional.arq.br#300002932 -->

    <owl:Class rdf:about="http://vocabulario.tradicional.arq.br#300002932">
        <rdfs:subClassOf rdf:resource="http://vocab.getty.edu/ontology#Concept"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/iso25964/skos-thes#broaderGeneric"/>
                <owl:someValuesFrom rdf:resource="http://vocabulario.tradicional.arq.br#300003146"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/iso25964/skos-thes#broaderGeneric"/>
                <owl:someValuesFrom rdf:resource="http://www.co-ode.org/ontologies/ont.owl#OWLClass_227c7e8e_84b3_435d_b1ef_92e7f65b9a3d"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://vocab.getty.edu/ontology#broaderPreferred"/>
                <owl:someValuesFrom rdf:resource="http://vocabulario.tradicional.arq.br#300003146"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:creator>http://vocab.getty.edu/page/aat/300002932</terms:creator>
        <terms:description xml:lang="pt-br">Portas ou portões secundários, muitas vezes discretos, especialmente em recintos fortificados ou murados; também podem ser usados ​​para entradas menores, privadas ou laterais.</terms:description>
        <terms:title xml:lang="pt-br">Postigo</terms:title>
    </owl:Class>
    


    <!-- http://vocabulario.tradicional.arq.br#300003009 -->

    <owl:Class rdf:about="http://vocabulario.tradicional.arq.br#300003009">
        <rdfs:subClassOf rdf:resource="http://vocab.getty.edu/ontology#Concept"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/iso25964/skos-thes#broaderGeneric"/>
                <owl:someValuesFrom rdf:resource="http://vocabulario.tradicional.arq.br#300266766"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/iso25964/skos-thes#broaderGeneric"/>
                <owl:someValuesFrom rdf:resource="http://www.co-ode.org/ontologies/ont.owl#OWLClass_227c7e8e_84b3_435d_b1ef_92e7f65b9a3d"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
