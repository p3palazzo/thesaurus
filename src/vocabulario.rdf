            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:creator>http://vocab.getty.edu/page/aat/300003009</terms:creator>
        <terms:description xml:lang="pt-br">Janelas de batente, fixas ou articuladas, com montantes dispostos diagonalmente.</terms:description>
        <terms:title xml:lang="pt-br">rótula (janelas de treliça)</terms:title>
    </owl:Class>
    


    <!-- http://vocabulario.tradicional.arq.br#300003092 -->

    <owl:Class rdf:about="http://vocabulario.tradicional.arq.br#300003092">
        <rdfs:subClassOf rdf:resource="http://vocab.getty.edu/ontology#Concept"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/iso25964/skos-thes#broaderGeneric"/>
                <owl:someValuesFrom rdf:resource="http://vocabulario.tradicional.arq.br#300003146"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/iso25964/skos-thes#broaderGeneric"/>
                <owl:someValuesFrom rdf:resource="http://www.co-ode.org/ontologies/ont.owl#OWLClass_227c7e8e_84b3_435d_b1ef_92e7f65b9a3d"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://vocab.getty.edu/ontology#broaderPreferred"/>
                <owl:someValuesFrom rdf:resource="http://vocabulario.tradicional.arq.br#300003146"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:creator>http://vocab.getty.edu/page/aat/300003092</terms:creator>
        <terms:description xml:lang="pt-br">Barras ou pilares delgados, verticais, geralmente não estruturais, que formam uma divisão entre portas, divisórias ou painéis de janelas; para os pequenos elementos que dividem as áreas envidraçadas e suportam os painéis ou as verticais que separam os painéis em portas de painéis, use &quot;montantes&quot;.</terms:description>
        <terms:title xml:lang="pt-br">montantes</terms:title>
    </owl:Class>
    


    <!-- http://vocabulario.tradicional.arq.br#300003115 -->

    <owl:Class rdf:about="http://vocabulario.tradicional.arq.br#300003115">
        <rdfs:subClassOf rdf:resource="http://vocab.getty.edu/ontology#Concept"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/iso25964/skos-thes#broaderGeneric"/>
                <owl:someValuesFrom rdf:resource="http://www.co-ode.org/ontologies/ont.owl#OWLClass_227c7e8e_84b3_435d_b1ef_92e7f65b9a3d"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://vocab.getty.edu/ontology#broaderPreferred"/>
                <owl:someValuesFrom rdf:resource="http://www.co-ode.org/ontologies/ont.owl#OWLClass_227c7e8e_84b3_435d_b1ef_92e7f65b9a3d"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:creator>http://vocab.getty.edu/page/aat/300003115</terms:creator>
        <terms:description xml:lang="pt-br">Cortinas horizontais fixadas na parte superior de uma abertura; geralmente usadas como cabeçalhos decorativos para ocultar a parte superior das cortinas e seus acessórios.</terms:description>
        <terms:title xml:lang="pt-br">Lambrequim (bandôs)</terms:title>
    </owl:Class>
    


    <!-- http://vocabulario.tradicional.arq.br#300003146 -->

    <owl:Class rdf:about="http://vocabulario.tradicional.arq.br#300003146">
        <rdfs:subClassOf rdf:resource="http://vocab.getty.edu/ontology#Concept"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/iso25964/skos-thes#broaderGeneric"/>
                <owl:someValuesFrom rdf:resource="http://www.co-ode.org/ontologies/ont.owl#OWLClass_227c7e8e_84b3_435d_b1ef_92e7f65b9a3d"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://vocab.getty.edu/ontology#broaderPreferred"/>
                <owl:someValuesFrom rdf:resource="http://www.co-ode.org/ontologies/ont.owl#OWLClass_227c7e8e_84b3_435d_b1ef_92e7f65b9a3d"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:creator>http://vocab.getty.edu/page/aat/300003146</terms:creator>
        <terms:description xml:lang="pt-br">Elementos verticais em ambos os lados de batentes de portas, janelas ou similares.</terms:description>
        <terms:title xml:lang="pt-br">Ombreira (jambas (componentes de abertura))</terms:title>
    </owl:Class>
    


    <!-- http://vocabulario.tradicional.arq.br#300003176 -->

    <owl:Class rdf:about="http://vocabulario.tradicional.arq.br#300003176">
        <rdfs:subClassOf rdf:resource="http://vocab.getty.edu/ontology#Concept"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/iso25964/skos-thes#broaderGeneric"/>
                <owl:someValuesFrom rdf:resource="http://vocabulario.tradicional.arq.br#300266766"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/iso25964/skos-thes#broaderGeneric"/>
                <owl:someValuesFrom rdf:resource="http://www.co-ode.org/ontologies/ont.owl#OWLClass_227c7e8e_84b3_435d_b1ef_92e7f65b9a3d"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://vocab.getty.edu/ontology#broaderPreferred"/>
                <owl:someValuesFrom rdf:resource="http://vocabulario.tradicional.arq.br#300266766"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:creator>http://vocab.getty.edu/page/aat/300003176</terms:creator>
        <terms:description xml:lang="pt-br">Persianas com lâminas fixas que se inclinam para cima a partir do exterior, de modo a bloquear o sol e a chuva, permitindo a entrada de ar e alguma luz. Para persianas semelhantes com lâminas móveis, utilize o termo &quot;persianas venezianas&quot;.</terms:description>
        <terms:title xml:lang="pt-br">Gelosia (persianas)</terms:title>
    </owl:Class>
    


    <!-- http://vocabulario.tradicional.arq.br#300003545 -->

    <owl:Class rdf:about="http://vocabulario.tradicional.arq.br#300003545">
        <rdfs:subClassOf rdf:resource="http://vocab.getty.edu/ontology#Concept"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/iso25964/skos-thes#broaderGeneric"/>
                <owl:someValuesFrom rdf:resource="http://www.co-ode.org/ontologies/ont.owl#OWLClass_227c7e8e_84b3_435d_b1ef_92e7f65b9a3d"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://vocab.getty.edu/ontology#broaderPreferred"/>
                <owl:someValuesFrom rdf:resource="http://www.co-ode.org/ontologies/ont.owl#OWLClass_227c7e8e_84b3_435d_b1ef_92e7f65b9a3d"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:creator>http://vocab.getty.edu/page/aat/300003545</terms:creator>
        <terms:description xml:lang="pt-br">Molduras planas, retangulares e horizontais.</terms:description>
        <terms:title xml:lang="pt-br">Platibanda</terms:title>
    </owl:Class>
    


    <!-- http://vocabulario.tradicional.arq.br#300003610 -->

    <owl:Class rdf:about="http://vocabulario.tradicional.arq.br#300003610">
        <rdfs:subClassOf rdf:resource="http://vocab.getty.edu/ontology#Concept"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/iso25964/skos-thes#broaderGeneric"/>
                <owl:someValuesFrom rdf:resource="http://www.co-ode.org/ontologies/ont.owl#OWLClass_227c7e8e_84b3_435d_b1ef_92e7f65b9a3d"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://vocab.getty.edu/ontology#broaderPreferred"/>
                <owl:someValuesFrom rdf:resource="http://www.co-ode.org/ontologies/ont.owl#OWLClass_227c7e8e_84b3_435d_b1ef_92e7f65b9a3d"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:creator>http://vocab.getty.edu/page/aat/300003610</terms:creator>
        <terms:description xml:lang="pt-br">Blocos de alvenaria em balanço usados ​​individualmente ou em conjuntos para suportar elementos arquitetônicos ou ornamentais, ou usados ​​em fiadas sucessivas para formar arcos, cúpulas ou abóbadas; quando se refere de forma geral às fiadas de alvenaria salientes, prefere-se &quot;fiadas sobrepostas&quot;.</terms:description>
        <terms:title xml:lang="pt-br">Cachorro</terms:title>
        <rdfs:comment xml:lang="pt-br">Também referido como &quot;mísulas&quot; em terminologia técnica geral.</rdfs:comment>
    </owl:Class>
    


    <!-- http://vocabulario.tradicional.arq.br#300004054 -->

    <owl:Class rdf:about="http://vocabulario.tradicional.arq.br#300004054">
        <rdfs:subClassOf rdf:resource="http://vocab.getty.edu/ontology#Concept"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/iso25964/skos-thes#broaderGeneric"/>
                <owl:someValuesFrom rdf:resource="http://www.co-ode.org/ontologies/ont.owl#OWLClass_227c7e8e_84b3_435d_b1ef_92e7f65b9a3d"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://vocab.getty.edu/ontology#broaderPreferred"/>
                <owl:someValuesFrom rdf:resource="http://www.co-ode.org/ontologies/ont.owl#OWLClass_227c7e8e_84b3_435d_b1ef_92e7f65b9a3d"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:creator>http://vocab.getty.edu/page/aat/300004054</terms:creator>
        <terms:description xml:lang="pt-br">Utilize para delimitar pequenos espaços recuados em salas maiores.</terms:description>
        <terms:title xml:lang="pt-br">Alcova</terms:title>
    </owl:Class>
    


    <!-- http://vocabulario.tradicional.arq.br#300004095 -->

    <owl:Class rdf:about="http://vocabulario.tradicional.arq.br#300004095">
        <rdfs:subClassOf rdf:resource="http://vocab.getty.edu/ontology#Concept"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/iso25964/skos-thes#broaderGeneric"/>
                <owl:someValuesFrom rdf:resource="http://www.co-ode.org/ontologies/ont.owl#OWLClass_227c7e8e_84b3_435d_b1ef_92e7f65b9a3d"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://vocab.getty.edu/ontology#broaderPreferred"/>
                <owl:someValuesFrom rdf:resource="http://www.co-ode.org/ontologies/ont.owl#OWLClass_227c7e8e_84b3_435d_b1ef_92e7f65b9a3d"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:creator>http://vocab.getty.edu/page/aat/300004095</terms:creator>
        <terms:description xml:lang="pt-br">Áreas descobertas, cercadas ou parcialmente cercadas pelas paredes de um edifício. Um espaço livre delimitado por paredes ou cercado por edifícios.</terms:description>
        <terms:title xml:lang="pt-br">Terreiro (pátios)</terms:title>
    </owl:Class>
    


    <!-- http://vocabulario.tradicional.arq.br#300004132 -->

    <owl:Class rdf:about="http://vocabulario.tradicional.arq.br#300004132">
        <rdfs:subClassOf rdf:resource="http://vocab.getty.edu/ontology#Concept"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/iso25964/skos-thes#broaderGeneric"/>
                <owl:someValuesFrom rdf:resource="http://www.co-ode.org/ontologies/ont.owl#OWLClass_227c7e8e_84b3_435d_b1ef_92e7f65b9a3d"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://vocab.getty.edu/ontology#broaderPreferred"/>
                <owl:someValuesFrom rdf:resource="http://www.co-ode.org/ontologies/ont.owl#OWLClass_227c7e8e_84b3_435d_b1ef_92e7f65b9a3d"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:creator>http://vocab.getty.edu/page/aat/300004132</terms:creator>
        <terms:description xml:lang="pt-br">Espaços cobertos, abertos em um ou mais lados, adjacentes a uma edificação, geralmente servindo para abrigar uma entrada ou como espaço de estar; no contexto luso-brasileiro, corresponde ao termo local &quot;alpendre&quot;.</terms:description>
        <terms:title xml:lang="pt">Alpendre</terms:title>
    </owl:Class>
    


    <!-- http://vocabulario.tradicional.arq.br#300004182 -->

    <owl:Class rdf:about="http://vocabulario.tradicional.arq.br#300004182">
        <rdfs:subClassOf rdf:resource="http://vocab.getty.edu/ontology#Concept"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/iso25964/skos-thes#broaderGeneric"/>
                <owl:someValuesFrom rdf:resource="http://vocabulario.tradicional.arq.br#300004095"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/iso25964/skos-thes#broaderGeneric"/>
                <owl:someValuesFrom rdf:resource="http://www.co-ode.org/ontologies/ont.owl#OWLClass_227c7e8e_84b3_435d_b1ef_92e7f65b9a3d"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://vocab.getty.edu/ontology#broaderPreferred"/>
                <owl:someValuesFrom rdf:resource="http://vocabulario.tradicional.arq.br#300004095"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:creator>http://vocab.getty.edu/page/aat/300004182</terms:creator>
        <terms:description xml:lang="pt-br">Áreas pavimentadas ou ajardinadas niveladas, geralmente elevadas em relação ao terreno circundante e adjacentes a edifícios ou partes de complexos de jardins, ou, se estiverem dentro de um edifício, nos andares superiores ou no telhado.</terms:description>
        <terms:title xml:lang="pt-br">Eirado (terraços)</terms:title>
    </owl:Class>
    


    <!-- http://vocabulario.tradicional.arq.br#300004283 -->

    <owl:Class rdf:about="http://vocabulario.tradicional.arq.br#300004283">
        <rdfs:subClassOf rdf:resource="http://vocab.getty.edu/ontology#Concept"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/iso25964/skos-thes#broaderGeneric"/>
                <owl:someValuesFrom rdf:resource="http://www.co-ode.org/ontologies/ont.owl#OWLClass_227c7e8e_84b3_435d_b1ef_92e7f65b9a3d"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://vocab.getty.edu/ontology#broaderPreferred"/>
                <owl:someValuesFrom rdf:resource="http://www.co-ode.org/ontologies/ont.owl#OWLClass_227c7e8e_84b3_435d_b1ef_92e7f65b9a3d"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:creator>http://vocab.getty.edu/page/aat/300004283</terms:creator>
        <terms:description xml:lang="pt-br">Espaços relativamente estreitos projetados para facilitar o acesso; geralmente espaços interiores.</terms:description>
        <terms:title xml:lang="pt-br">corredores</terms:title>
    </owl:Class>
    


    <!-- http://vocabulario.tradicional.arq.br#300004627 -->

    <owl:Class rdf:about="http://vocabulario.tradicional.arq.br#300004627">
        <rdfs:subClassOf rdf:resource="http://vocab.getty.edu/ontology#Concept"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/iso25964/skos-thes#broaderGeneric"/>
                <owl:someValuesFrom rdf:resource="http://www.co-ode.org/ontologies/ont.owl#OWLClass_227c7e8e_84b3_435d_b1ef_92e7f65b9a3d"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://vocab.getty.edu/ontology#broaderPreferred"/>
                <owl:someValuesFrom rdf:resource="http://www.co-ode.org/ontologies/ont.owl#OWLClass_227c7e8e_84b3_435d_b1ef_92e7f65b9a3d"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:creator>http://vocab.getty.edu/page/aat/300004627</terms:creator>
        <terms:description xml:lang="pt-br">Refere-se à parte central principal de um interior, dividida em um núcleo alto com porções laterais mais baixas, separadas por colunas ou pilares, geralmente, mas nem sempre, em uma igreja. Também pode ser usado para a parte principal de uma igreja sem naves laterais, mas com um presbitério distinto.</terms:description>
        <terms:title xml:lang="pt-br">naves</terms:title>
    </owl:Class>
    


