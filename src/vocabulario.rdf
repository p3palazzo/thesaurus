        </rdfs:subClassOf>
        <terms:creator>http://vocab.getty.edu/page/aat/300010525</terms:creator>
        <terms:description xml:lang="pt-br">Um tijolo que atende às especificações para uma unidade de alvenaria maciça.</terms:description>
        <terms:title xml:lang="pt-br">tijolo maciço</terms:title>
    </owl:Class>
    


    <!-- http://vocabulario.tradicional.arq.br#300010713 -->

    <owl:Class rdf:about="http://vocabulario.tradicional.arq.br#300010713">
        <rdfs:subClassOf rdf:resource="http://vocab.getty.edu/ontology#Concept"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/iso25964/skos-thes#broaderGeneric"/>
                <owl:someValuesFrom rdf:resource="http://www.co-ode.org/ontologies/ont.owl#OWLClass_0c206ee3_b1a1_4659_be1c_bfc039fb4a6f"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://vocab.getty.edu/ontology#broaderPreferred"/>
                <owl:someValuesFrom rdf:resource="http://www.co-ode.org/ontologies/ont.owl#OWLClass_0c206ee3_b1a1_4659_be1c_bfc039fb4a6f"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:creator>http://vocab.getty.edu/page/aat/300010713</terms:creator>
        <terms:description xml:lang="pt-br">Na arquitetura antiga, o termo era usado para descrever uma telha plana ou tégula. No uso moderno, refere-se a uma telha de cobertura em forma de S, assentada de modo que a curvatura descendente de uma telha se sobreponha à curvatura ascendente da seguinte.</terms:description>
        <terms:title xml:lang="pt-br">Telha Canal (ou Coxa) (telha de barro)</terms:title>
    </owl:Class>
    


    <!-- http://vocabulario.tradicional.arq.br#300011677 -->

    <owl:Class rdf:about="http://vocabulario.tradicional.arq.br#300011677">
        <rdfs:subClassOf rdf:resource="http://vocab.getty.edu/ontology#Concept"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/iso25964/skos-thes#broaderGeneric"/>
                <owl:someValuesFrom rdf:resource="http://www.co-ode.org/ontologies/ont.owl#OWLClass_2812bd42_b959_4829_b028_e0ab52515ffd"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://vocab.getty.edu/ontology#broaderPreferred"/>
                <owl:someValuesFrom rdf:resource="http://www.co-ode.org/ontologies/ont.owl#OWLClass_2812bd42_b959_4829_b028_e0ab52515ffd"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:creator>http://vocab.getty.edu/page/aat/300011677</terms:creator>
        <terms:description xml:lang="pt-br">Um fragmento de rocha, arredondado ou desgastado de alguma outra forma, com diâmetro entre 64 e 256 mm, sendo maior que um seixo e menor que um bloco rochoso. O termo também pode se referir mais especificamente a uma pedra arredondada adequada para uso em pavimentação ou outras construções.</terms:description>
        <terms:title xml:lang="pt-br">Pé-de-moleque (calçada)</terms:title>
    </owl:Class>
    


