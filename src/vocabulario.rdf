            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:creator>http://vocab.getty.edu/page/aat/300445666</terms:creator>
        <terms:description xml:lang="pt-br">Seções de nova construção anexadas a uma obra existente, com a função de adicionar uma extensão ou aumentar a área ou altura de um edifício existente além do seu perímetro original.</terms:description>
        <terms:title xml:lang="pt-br">Adição/Acréscimo</terms:title>
    </owl:Class>
    


    <!-- http://vocabulario.tradicional.arq.br#300451680 -->

    <owl:Class rdf:about="http://vocabulario.tradicional.arq.br#300451680">
        <rdfs:subClassOf rdf:resource="http://vocab.getty.edu/ontology#Concept"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/iso25964/skos-thes#broaderGeneric"/>
                <owl:someValuesFrom rdf:resource="http://www.co-ode.org/ontologies/ont.owl#OWLClass_227c7e8e_84b3_435d_b1ef_92e7f65b9a3d"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/iso25964/skos-thes#broaderGeneric"/>
                <owl:someValuesFrom rdf:resource="https://vocab.getty.edu/aat/300004790"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://vocab.getty.edu/ontology#broaderPreferred"/>
                <owl:someValuesFrom rdf:resource="https://vocab.getty.edu/aat/300004790"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:creator>http://vocab.getty.edu/page/aat/300451680</terms:creator>
        <terms:description xml:lang="pt-br">Residências separadas por uma parede comum, geralmente de madeira. Podem ter resultado da divisão de uma residência maior em duas. Distinguem-se das casas geminadas (casas semi-isoladas), que compreendem duas residências separadas, mas imediatamente adjacentes, frequentemente em duas propriedades, separadas por paredes divisórias de alvenaria. Uma característica distintiva mais facilmente identificável pode ser a porta de entrada; casas geminadas podem ter uma única porta de entrada com um hall de entrada comum, enquanto uma casa semi-isolada</terms:description>
        <terms:title xml:lang="pt-br">Meia-morada (casas geminadas)</terms:title>
    </owl:Class>
    


    <!-- http://vocabulario.tradicional.arq.br#300457778 -->

    <owl:Class rdf:about="http://vocabulario.tradicional.arq.br#300457778">
